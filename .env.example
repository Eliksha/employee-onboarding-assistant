# Copy this file to .env and fill in real values. NEVER commit .env
# Azure OpenAI (the only LLM provider): resource v1 endpoint, deployment name, API key
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_KEY=replace_with_local_secret
EMBED_MODEL=BAAI/bge-small-en-v1.5
# bge similarity scores are compressed (relevant ~0.6-0.85, unrelated ~0.35-0.5): tune on your test questions
SIMILARITY_THRESHOLD=0.65
TOP_K=4
# Optional tuning (commented lines show the code defaults; uncomment only to change them)
# BORDERLINE_MARGIN=0.05
# CHUNK_WORDS=350
# CHUNK_OVERLAP_WORDS=40
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# LLM_MAX_OUTPUT_TOKENS=600
# File locations (relative to the project root)
# RAW_DIR=data/raw
# INDEX_DIR=data/index
# DB_PATH=data/app.db
# LOG_DIR=logs

# Database configuration
# Supported backends: sqlite, postgresql
# Set to postgresql when using PostgreSQL 16
DB_BACKEND=postgresql

# PostgreSQL connection settings
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=onboardai
PG_USER=postgres
PG_PASSWORD=replace_with_local_secret
# /health database probe timeout in seconds (connect + statement); libpq minimum is 2
HEALTH_DB_TIMEOUT_SECONDS=3
# Server-side statement timeout for application connections (ms; 0 disables)
PG_STATEMENT_TIMEOUT_MS=10000
# The backend refuses to start when PG_USER is a superuser or BYPASSRLS role. Local-development escape
# hatch only (honoured solely with APP_ENV=development; docker-compose.yml pins it to false):
ALLOW_PRIVILEGED_DB_CONNECTION=false
# TLS to PostgreSQL: prefer (default) | require | verify-full (Azure: verify-full with the server's CA bundle file)
# PG_SSLMODE=prefer
# PG_SSLROOTCERT=
# Connection pool (per credential set and instance; keep instances x size within the role CONNECTION LIMITs)
# PG_POOL_ENABLED=true
# PG_POOL_MAX_SIZE=5
# PG_POOL_TIMEOUT_SECONDS=5
# PG_POOL_MAX_LIFETIME_SECONDS=1800
# PG_POOL_VALIDATE_IDLE_SECONDS=5

# Least-privilege roles (create with backend/migrations/005_least_privilege_roles.py, see docs/runbook.md).
# After provisioning, set PG_USER/PG_PASSWORD above to the APP role (onboardai_app) instead of an owner/superuser.
# Read-only SQL-agent role; when empty, read-only queries use PG_USER inside READ ONLY transactions.
PG_READER_USER=
PG_READER_PASSWORD=
# HMAC secret for the signed employee scope (32+ chars; required with PG_READER_USER; same value given to
# migration 005 as ONBOARDAI_SCOPE_SECRET)
PG_SCOPE_SECRET=
# SQL-agent query limits
SQL_AGENT_STATEMENT_TIMEOUT_MS=5000
SQL_AGENT_MAX_ROWS=200

# Docker only (docker-compose.yml): password for the container-only PostgreSQL.
# Set it in your shell, e.g. $env:DOCKER_PG_PASSWORD = "<local value>"; do not reuse a real password.

# Authentication and sessions (defaults shown; no secrets required)
APP_ENV=development
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
# auto = Secure cookie whenever the request is HTTPS; set true when serving over HTTPS
SESSION_COOKIE_SECURE=auto
# true only behind a trusted reverse proxy (Docker Compose sets this for the backend)
TRUST_PROXY_HEADERS=false
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_SECONDS=900
PASSWORD_MIN_LENGTH=12
# auto = shared login_failures table on PostgreSQL (migration 008), process memory on SQLite; or memory | database
# LOGIN_RATE_LIMIT_BACKEND=auto
# LOGIN_RATE_LIMIT_MAX_KEYS=10000
# SESSION_COOKIE_NAME=onboardai_session
# Number of trusted reverse-proxy hops in X-Forwarded-For (with TRUST_PROXY_HEADERS=true; Azure deployment: 3)
# TRUSTED_PROXY_HOPS=1
# Azure deployment: shared key the frontend proxy sends; when set, requests without it are rejected (32+ chars)
# BACKEND_PROXY_SECRET=
# API documentation (/docs, /redoc, /openapi.json): unset = only when APP_ENV=development
# API_DOCS=false
# Account passwords are never stored here: provision accounts with `python -m backend.manage_accounts`.
