{
  "version": 1,
  "description": "Schema dictionary for the OnboardAI PostgreSQL database (schema public), with migration 005 row-level security and migration 007 integrity constraints applied. Validated against the live catalog by tests/integration/test_postgres_m4.py and `python -m scripts.schema_dictionary --check`. The security schemas onboardai_private and onboardai_rls are intentionally not described.",
  "tables": {
    "assets": {
      "description": "IT assets assigned to employees.",
      "personal_data": true,
      "sensitive": false,
      "row_level_security": true,
      "reader_access": true,
      "import_file": "assets.csv",
      "columns": {
        "asset_id": {
          "type": "text",
          "nullable": false,
          "description": "Asset identifier, e.g. AST001."
        },
        "employee_id": {
          "type": "text",
          "nullable": false,
          "description": "Assigned employee."
        },
        "asset_type": {
          "type": "text",
          "nullable": false,
          "description": "Asset category, e.g. Laptop."
        },
        "asset_name": {
          "type": "text",
          "nullable": false,
          "description": "Model name."
        },
        "status": {
          "type": "text",
          "nullable": false,
          "description": "assigned / returned / in_repair / lost."
        }
      },
      "primary_key": [
        "asset_id"
      ],
      "unique": [],
      "foreign_keys": [
        {
          "columns": [
            "employee_id"
          ],
          "references": {
            "table": "employees",
            "columns": [
              "employee_id"
            ]
          },
          "on_delete": "NO ACTION"
        }
      ]
    },
    "checklist": {
      "description": "Onboarding task catalogue (Day 1 / Week 1 / Month 1).",
      "personal_data": false,
      "sensitive": false,
      "row_level_security": false,
      "reader_access": true,
      "import_file": "checklist.csv",
      "columns": {
        "id": {
          "type": "integer",
          "nullable": false,
          "description": "Task identifier."
        },
        "phase": {
          "type": "text",
          "nullable": true,
          "description": "Day 1, Week 1 or Month 1."
        },
        "task": {
          "type": "text",
          "nullable": true,
          "description": "Task description."
        },
        "done": {
          "type": "integer",
          "nullable": true,
          "description": "Legacy global completion flag (admin-only legacy route; per-employee progress is in checklist_assignments)."
        }
      },
      "primary_key": [
        "id"
      ],
      "unique": [],
      "foreign_keys": []
    },
    "checklist_assignments": {
      "description": "Per-employee onboarding progress.",
      "personal_data": true,
      "sensitive": false,
      "row_level_security": true,
      "reader_access": true,
      "import_file": "checklist_assignments.csv",
      "columns": {
        "employee_id": {
          "type": "text",
          "nullable": false,
          "description": "Employee."
        },
        "checklist_id": {
          "type": "integer",
          "nullable": false,
          "description": "Task from checklist."
        },
        "done": {
          "type": "integer",
          "nullable": false,
          "description": "1 when the employee completed the task, else 0."
        }
      },
      "primary_key": [
        "employee_id",
        "checklist_id"
      ],
      "unique": [],
      "foreign_keys": [
        {
          "columns": [
            "checklist_id"
          ],
          "references": {
            "table": "checklist",
            "columns": [
              "id"
            ]
          },
          "on_delete": "NO ACTION"
        },
        {
          "columns": [
            "employee_id"
          ],
          "references": {
            "table": "employees",
            "columns": [
              "employee_id"
            ]
          },
          "on_delete": "NO ACTION"
        }
      ]
    },
    "employees": {
      "description": "Synthetic employee profiles (HR master data).",
      "personal_data": true,
      "sensitive": false,
      "row_level_security": true,
      "reader_access": true,
      "import_file": "employees.csv",
      "columns": {
        "employee_id": {
          "type": "text",
          "nullable": false,
          "description": "Employee identifier, e.g. EMP001."
        },
        "name": {
          "type": "text",
          "nullable": false,
          "description": "Full name."
        },
        "email": {
          "type": "text",
          "nullable": false,
          "description": "Work email (unique)."
        },
        "department": {
          "type": "text",
          "nullable": false,
          "description": "Department name."
        },
        "joining_date": {
          "type": "text",
          "nullable": false,
          "description": "Joining date, ISO YYYY-MM-DD (stored as text)."
        },
        "location": {
          "type": "text",
          "nullable": false,
          "description": "Office city."
        }
      },
      "primary_key": [
        "employee_id"
      ],
      "unique": [
        [
          "email"
        ]
      ],
      "foreign_keys": []
    },
    "escalations": {
      "description": "Simulated HR/IT escalations, attributed to the escalating employee and optionally to a chat answer.",
      "personal_data": true,
      "sensitive": false,
      "row_level_security": false,
      "reader_access": false,
      "import_file": null,
      "columns": {
        "id": {
          "type": "integer",
          "nullable": false,
          "description": "Escalation identifier (identity)."
        },
        "question": {
          "type": "text",
          "nullable": true,
          "description": "Escalated question."
        },
        "contact_pref": {
          "type": "text",
          "nullable": true,
          "description": "Preferred contact."
        },
        "status": {
          "type": "text",
          "nullable": true,
          "description": "open / in_progress / resolved / closed."
        },
        "created_at": {
          "type": "text",
          "nullable": true,
          "description": "ISO timestamp (text)."
        },
        "employee_id": {
          "type": "text",
          "nullable": true,
          "description": "Escalating employee (NULL for accounts without an employee workspace)."
        },
        "message_id": {
          "type": "integer",
          "nullable": true,
          "description": "Escalated chat answer (NULL for free-text escalations; set NULL if the message is deleted)."
        }
      },
      "primary_key": [
        "id"
      ],
      "unique": [],
      "foreign_keys": [
        {
          "columns": [
            "employee_id"
          ],
          "references": {
            "table": "employees",
            "columns": [
              "employee_id"
            ]
          },
          "on_delete": "NO ACTION"
        },
        {
          "columns": [
            "message_id"
          ],
          "references": {
            "table": "messages",
            "columns": [
              "id"
            ]
          },
          "on_delete": "SET NULL"
        }
      ]
    },
    "feedback": {
      "description": "Thumbs up/down feedback on chat messages.",
      "personal_data": false,
      "sensitive": false,
      "row_level_security": false,
      "reader_access": false,
      "import_file": null,
      "columns": {
        "id": {
          "type": "integer",
          "nullable": false,
          "description": "Feedback identifier (identity)."
        },
        "message_id": {
          "type": "integer",
          "nullable": false,
          "description": "Rated message (required; feedback is deleted with its message)."
        },
        "rating": {
          "type": "text",
          "nullable": true,
          "description": "up or down."
        },
        "comment": {
          "type": "text",
          "nullable": true,
          "description": "Optional user comment."
        },
        "created_at": {
          "type": "text",
          "nullable": true,
          "description": "ISO timestamp (text)."
        }
      },
      "primary_key": [
        "id"
      ],
      "unique": [],
      "foreign_keys": [
        {
          "columns": [
            "message_id"
          ],
          "references": {
            "table": "messages",
            "columns": [
              "id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ]
    },
    "leave_balances": {
      "description": "Available leave days per employee and leave type.",
      "personal_data": true,
      "sensitive": false,
      "row_level_security": true,
      "reader_access": true,
      "import_file": "leave_balances.csv",
      "columns": {
        "id": {
          "type": "integer",
          "nullable": false,
          "description": "Surrogate key (identity)."
        },
        "employee_id": {
          "type": "text",
          "nullable": false,
          "description": "Owner employee."
        },
        "leave_type": {
          "type": "text",
          "nullable": false,
          "description": "Leave type, e.g. Casual Leave."
        },
        "available_days": {
          "type": "double precision",
          "nullable": false,
          "description": "Days still available (>= 0)."
        }
      },
      "primary_key": [
        "id"
      ],
      "unique": [
        [
          "employee_id",
          "leave_type"
        ]
      ],
      "foreign_keys": [
        {
          "columns": [
            "employee_id"
          ],
          "references": {
            "table": "employees",
            "columns": [
              "employee_id"
            ]
          },
          "on_delete": "NO ACTION"
        }
      ]
    },
    "messages": {
      "description": "Chat history; one row per chat exchange.",
      "personal_data": true,
      "sensitive": false,
      "row_level_security": false,
      "reader_access": false,
      "import_file": null,
      "columns": {
        "id": {
          "type": "integer",
          "nullable": false,
          "description": "Message identifier (identity)."
        },
        "question": {
          "type": "text",
          "nullable": true,
          "description": "User question."
        },
        "answer": {
          "type": "text",
          "nullable": true,
          "description": "Assistant answer."
        },
        "found": {
          "type": "integer",
          "nullable": true,
          "description": "1 when the answer was found in records or the handbook, else 0."
        },
        "sources": {
          "type": "text",
          "nullable": true,
          "description": "JSON list of cited sources."
        },
        "created_at": {
          "type": "text",
          "nullable": true,
          "description": "ISO timestamp (text)."
        },
        "employee_id": {
          "type": "text",
          "nullable": true,
          "description": "Owner employee (NULL for legacy/admin messages)."
        }
      },
      "primary_key": [
        "id"
      ],
      "unique": [],
      "foreign_keys": [
        {
          "columns": [
            "employee_id"
          ],
          "references": {
            "table": "employees",
            "columns": [
              "employee_id"
            ]
          },
          "on_delete": "NO ACTION"
        }
      ]
    },
    "payroll_calendar": {
      "description": "Company-wide payroll payment dates (no per-employee pay data).",
