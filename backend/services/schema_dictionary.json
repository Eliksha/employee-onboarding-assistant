        "payment_date": {
          "type": "text",
          "nullable": false,
          "description": "Payment date YYYY-MM-DD (stored as text)."
        },
        "status": {
          "type": "text",
          "nullable": false,
          "description": "scheduled / processed / paid / cancelled."
        }
      },
      "primary_key": [
        "id"
      ],
      "unique": [
        [
          "payroll_month"
        ]
      ],
      "foreign_keys": []
